# Copiar a .env (ignorado por git). Variables del servidor web (python -m narrator.web).
NARRATOR_ENV=development            # production exige NARRATOR_API_KEY y agrega HSTS
NARRATOR_API_KEY=                   # clave de administrador (Bearer); generá una larga y aleatoria
NARRATOR_WEB_DB=data/web/narrador_web.db   # sesiones y claves de usuarios (SQLite)
NARRATOR_CONFIG_PATH=./config/config.yaml
NARRATOR_MODEL=qwen3:1.7b           # modelo de Ollama para el narrador web
NARRATOR_ALLOWED_ORIGINS=           # orígenes permitidos separados por coma
NARRATOR_RATE_LIMIT=120             # pedidos por minuto por identidad (0 = sin límite)
NARRATOR_MAX_REQUEST_BYTES=262144
NARRATOR_TRUSTED_PROXIES=0          # 1 si corre detrás de Caddy/nginx
NARRATOR_HOST=127.0.0.1
NARRATOR_PORT=8765
